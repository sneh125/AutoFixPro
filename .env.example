# Django Core Settings
DJANGO_SECRET_KEY=your-super-secret-50-char-random-key-here
SECRET_KEY=your-super-secret-50-char-random-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com,www.yourdomain.com

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email SMTP Settings (Gmail / Production SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_digit_app_password
DEFAULT_FROM_EMAIL=AutoFixPro <your_email@gmail.com>

# OTP Security Parameters
EMAIL_OTP_EXPIRY_MINUTES=5
EMAIL_OTP_RESEND_SECONDS=30
EMAIL_OTP_MAX_ATTEMPTS=5

# Production SSL & Domain Security (When DEBUG=False)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_SSL_REDIRECT=False
ENABLE_HSTS=False
